DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hoatien
JWT_SECRET=doi-chuoi-nay-thanh-random-string-dai-truoc-khi-deploy
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ENV=development

# Rate limit theo IP — mặc định nới cho demo chung mạng (nhiều khán giả cùng 1 IP NAT)
RATE_LIMIT_CHAT=120/minute
RATE_LIMIT_LOGIN=30/minute

GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# "gemini" (mặc định — dùng chung GEMINI_API_KEY, 768 chiều) hoặc "deepinfra" (bge-m3, 1024 chiều)
# Đổi provider cần migration đổi cột Vector() + backfill lại — xem rules/ai-module.md
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
DEEPINFRA_API_KEY=
DEEPINFRA_EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_API_BASE_URL=https://api.deepinfra.com/v1/openai/embeddings

RAG_SEMANTIC_WEIGHT=4.0
